# Copier ce fichier en ".env" puis remplir les valeurs.
# Le fichier .env n'est JAMAIS envoyé sur GitHub (il est dans .gitignore).

# Clé secrète Flask (n'importe quelle longue chaîne aléatoire)
SECRET_KEY=change-moi

# --- Envoi des candidatures (Gmail) ---
# Adresse Gmail d'envoi
GMAIL_ADDRESS=ton.adresse@gmail.com
# Mot de passe d'application Gmail (PAS ton mot de passe normal)
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# --- Recherche d'offres (API France Travail) ---
# https://francetravail.io -> créer une application -> API "Offres d'emploi v2"
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
